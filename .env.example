# ============================================================
# Smart PDF Analyzer — Environment Variables Template
# ============================================================
# Copy this file and rename the copy to .env
# Fill in your real values in .env
# NEVER commit .env to GitHub
# ============================================================

# ------------------------------------------------------------
# REQUIRED — OpenAI
# ------------------------------------------------------------
# Get from: platform.openai.com → API Keys
OPENAI_API_KEY=sk-proj-your-key-here

# ------------------------------------------------------------
# OPTIONAL — LangSmith (recommended for development)
# ------------------------------------------------------------
# Get from: smith.langchain.com → Settings → API Keys
# Set LANGCHAIN_TRACING_V2=false to disable tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__your-key-here
LANGCHAIN_PROJECT=smart-pdf-analyzer